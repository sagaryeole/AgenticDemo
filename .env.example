# Copy this file to .env in the project root:   cp .env.example .env
# One root .env is enough: ADK looks for .env in the agent's folder, then in each
# parent folder, so every agent finds this one unless its folder has its own .env.
# .env is git-ignored. Never commit it.

# ---------------------------------------------------------------------------
# Gemini on Google Cloud (Vertex AI). Needed for agents 01 and 02, and for
# agents 07+ when MODEL_PROVIDER=gemini. Also needed by agent13's LLM judge.
# First run once:  gcloud auth application-default login
# ---------------------------------------------------------------------------
GOOGLE_GENAI_USE_ENTERPRISE=1
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# ---------------------------------------------------------------------------
# Global model switch for agents 07 onwards (see common/models.py)
# ---------------------------------------------------------------------------
MODEL_PROVIDER=gemini            # gemini or local
GEMINI_MODEL=gemini-2.5-flash

# Local model through LM Studio (Developer tab -> Start Server).
# Agents 03-06 always use these defaults (hardcoded), agents 07+ only when MODEL_PROVIDER=local.
LOCAL_MODEL_ID=qwen3.5-9b         # exact id from: curl http://127.0.0.1:1234/v1/models
LOCAL_API_BASE=http://127.0.0.1:1234/v1

# Override the provider for one agent only, e.g. run agent10 on Gemini while the rest use local:
# AGENT10_MODEL_PROVIDER=gemini

EMBEDDING_PROVIDER=local            # gemini or local 
GEMINI_EMBEDDING_MODEL=gemini-text-embedding-3-large
LOCAL_EMBEDDING_MODEL=text-embedding-embeddinggemma-300m